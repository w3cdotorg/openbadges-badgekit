export PORT=3000
export PERSONA_AUDIENCE=http://localhost:3000
export COOKIE_SECRET=blah
export DATABASE_DATABASE=badgekit
export DATABASE_DRIVER=mysql
export DATABASE_HOST=localhost
export DATABASE_PASSWORD=badgekit
export DATABASE_USER=badgekit
export OPENBADGER_SECRET=blah
export OPENBADGER_URL=https://localhost:3500
export BADGEKIT_API_URL=https://localhost:3500
export OPENBADGER_SYSTEM="badgekit"
export ACCESS_LIST='["*@mozilla(foundation)?.org"]'
export API_SECRET=blah
export BRANDING_CHICAGO=CHI
export BRANDING_LOSANGELES=LA
export BRANDING_DALLAS=DAL
export BRANDING_COLUMBUS=COL
export BRANDING_BOISE=BOI
export BRANDING_PHILADELPHIA=PHI
export BRANDING_PITTSBURGH=PIT

export NODE_ENV="development"
export ENABLE_GELF_LOGS=false

# AUTH_MODE: 'dev' (default, unverified email prompt) or 'oidc' (real IdP);
# the four OIDC_* vars below are only required when AUTH_MODE=oidc.
export AUTH_MODE=dev
export OIDC_ISSUER=https://your-idp.example.com
export OIDC_CLIENT_ID=badgekit
export OIDC_CLIENT_SECRET=change-me
export OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# NODE_ENV=production refuses to boot unless AUTH_MODE=oidc, because 'dev'
# mode accepts ANY email with no verification. WARNING: only set
# ALLOW_DEV_AUTH_IN_PRODUCTION=true if you are deliberately running
# unverified dev auth in production (e.g. break-glass/staging) — this
# disables a real security control.
export ALLOW_DEV_AUTH_IN_PRODUCTION=false

# Disable HSTS? (set to 'true' to disable HSTS, if you are not forcing ssl)
HSTS_DISABLED='true'

# Use Deny settings for X-Frame headers?
# set to 'true' to disable X-frames-options denial
DISABLE_XFO_HEADERS_DENY='false'

# Use default XSS protection?
# set to 'true' to disable IEXSS protection
IEXSS_PROTECTION_DISABLED='false'

# Mark the session cookie Secure (only sent over HTTPS). set true behind TLS
# (directly or behind a TLS-terminating proxy/load balancer) — leave false
# for plain-HTTP local development.
export SECURE_COOKIES=false
