# AUTH_MODE: 'dev' (default, unverified email prompt) or 'oidc' (real IdP);
# the four OIDC_* vars below are only required when AUTH_MODE=oidc.
export AUTH_MODE=dev
export OIDC_ISSUER=https://your-idp.example.com
export OIDC_CLIENT_ID=badgekit
